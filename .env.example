HTTP_ADDR=:8080
DATABASE_URL=postgres://vault:vault@localhost:5433/gvault?sslmode=disable
LOG_LEVEL=info

# Phase 1 product provider: NVIDIA Snapshot only (AMD is out of scope — docs/scope.md)
PROVIDER=nvidia-snapshot
ENABLE_NVIDIA_PROVIDER=true
PRODUCT_NAME=Gvault
UI_DIR=web
RESTORE_TIMEOUT_SECONDS=300

# Auth — prefer API key (or OIDC) outside localhost demos
DEV_AUTH_BYPASS=true
API_KEY=dev-local-key

# Optional namespace allowlist (comma-separated). Empty = allow all.
# ALLOWED_NAMESPACES=inference,platform

# Optional OIDC (HS256 staging verifier)
# OIDC_ISSUER=https://issuer.example
# OIDC_AUDIENCE=gvault
# OIDC_CLIENT_SECRET=

# S3/export remains fail-closed until upstream pin verifies export
ENABLE_S3_EXPORT=false
LEADER_ELECTION=false

# Kube access for live NVIDIA path (in-cluster config used inside a Pod when unset)
# KUBECONFIG=

# CI ONLY — not a product GPU provider. Do not use in demos or production.
# ALLOW_TEST_PROVIDER=true
# PROVIDER=fake
# FAKE_PROVIDER_STEP_MS=200
