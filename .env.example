HTTP_ADDR=:8080
DATABASE_URL=postgres://vault:vault@localhost:5433/gvault?sslmode=disable
LOG_LEVEL=info
PROVIDER=fake
PRODUCT_NAME=Gvault
UI_DIR=web
DEV_AUTH_BYPASS=true
API_KEY=dev-local-key
FAKE_PROVIDER_STEP_MS=200
# NVIDIA path (fail-closed without live cluster / kube client)
ENABLE_NVIDIA_PROVIDER=false
# Optional namespace allowlist (comma-separated). Empty = allow all.
# ALLOWED_NAMESPACES=inference,platform
# Optional OIDC (HS256 shared-secret verifier for staging; swap JWKS in prod)
# OIDC_ISSUER=https://issuer.example
# OIDC_AUDIENCE=gvault
# OIDC_CLIENT_SECRET=
# S3/export remains fail-closed until upstream pin verifies export
ENABLE_S3_EXPORT=false
LEADER_ELECTION=false
# KUBECONFIG=  # optional; in-cluster config used when unset inside a Pod
